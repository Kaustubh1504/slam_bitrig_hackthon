# Copy to supabase/functions/.env for local `supabase functions serve`.
# For the hosted project, set the same values with `supabase secrets set`.
OPENAI_API_KEY=
# A chat model that supports Structured Outputs (response_format json_schema).
OPENAI_MODEL=
# An image model for the Images API (GPT image models or DALL·E both work).
OPENAI_IMAGE_MODEL=

# Local only: origin the app can reach for cover art URLs (the edge runtime otherwise
# uses the Docker-internal http://kong:8000). Use your Mac's LAN IP for a physical iPhone.
# Leave unset on the hosted project.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
